{
  "name": "fufut-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy:staging": "wrangler deploy --name fufut-api-staging",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "local": "node local/server.js",
    "local:schema": "wrangler d1 execute fufut-db --remote --command \"SELECT sql FROM sqlite_master WHERE sql IS NOT NULL\""
  },
  "devDependencies": {
    "vitest": "^4.1.10",
    "wrangler": "^4.42.0"
  },
  "engines": {
    "node": ">=24"
  }
}
